---
import RootLayout from "~/layouts/RootLayout.astro";
---

<RootLayout>
  <section class="p-4 md:p-16">
    <h2 class="h2">About</h2>

    <br /><br />

    <p>
      OpenMusic is a fork of <a
        href="https://github.com/KRTirtho/spotube"
        target="_blank"
        class="underline">Spotube</a
      > by Kingkor Roy Tirtho, distributed under the original BSD-4-Clause licence.
      OpenMusic is not affiliated with or endorsed by the Spotube project or its authors.
    </p>

    <br /><br />

    <h4 class="h4">Upstream author</h4>
    <br />
    <a
      href="https://github.com/KRTirtho"
      target="_blank"
      class="btn preset-tonal-primary max-w-44 flex flex-col items-center p-4 rounded-2xl"
    >
      <img
        alt="Author of Spotube"
        src="https://github.com/KRTirtho.png"
        class="h-auto w-40 rounded-full"
      />
      <br />
      <h5>Kingkor Roy Tirtho</h5>
      <p>Author of Spotube</p>
    </a>
  </section>
</RootLayout>
