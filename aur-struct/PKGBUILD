# Maintainer: MaybeItsAdam <https://github.com/MaybeItsAdam>
pkgname=openmusic-bin
pkgver=%{{OPENMUSIC_VERSION}}%
pkgrel=%{{PKGREL}}%
epoch=
pkgdesc="Open source Music client that doesn't require Premium nor uses Electron! Available for both desktop & mobile!"
arch=(x86_64)
url="https://github.com/MaybeItsAdam/openmusic"
license=('BSD-4-Clause')
groups=()
depends=('mpv' 'libappindicator-gtk3' 'libsecret' 'jsoncpp' 'libnotify' 'xdg-user-dirs' 'webkit2gtk-4.1')
makedepends=()
checkdepends=()
optdepends=('yt-dlp-git')
provides=()
conflicts=()
replaces=()
backup=()
options=()
install=
changelog=
source=("https://github.com/MaybeItsAdam/openmusic/releases/download/v${pkgver}/openmusic-linux-${pkgver}-x86_64.tar.xz")
noextract=()
md5sums=(%{{LINUX_MD5}}%)
validpgpkeys=()

package() {
  install -dm755 "${pkgdir}/usr/share/icons/openmusic"
  install -dm755 "${pkgdir}/usr/share/applications"
  install -dm755 "${pkgdir}/usr/share/appdata"
  install -dm755 "${pkgdir}/usr/share/${pkgname}"
  install -dm755 "${pkgdir}/usr/bin"

  mv ./openmusic.desktop "${pkgdir}/usr/share/applications"
  mv ./openmusic-logo.png "${pkgdir}/usr/share/icons/openmusic/"
  mv ./io.github.MaybeItsAdam.OpenMusic.appdata.xml "${pkgdir}/usr/share/appdata/openmusic.appdata.xml"
  cp -ra ./data ./lib ./openmusic "${pkgdir}/usr/share/${pkgname}"
  sed -i 's|io.github.MaybeItsAdam.OpenMusic|openmusic|' "${pkgdir}/usr/share/appdata/openmusic.appdata.xml"
  ln -s "/usr/share/${pkgname}/openmusic" "${pkgdir}/usr/bin/openmusic"
}
